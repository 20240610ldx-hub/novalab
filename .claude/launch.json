{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bridge",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@novalab/bridge",
        "start"
      ],
      "port": 7788
    },
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@novalab/app",
        "exec",
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199,
      "url": "http://127.0.0.1:5199"
    }
  ]
}